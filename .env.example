# Setu — environment variables
#
# Client-visible (safe to expose in the browser bundle)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never exposed to the client; read inside server functions only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only LLM key used by the "Reconstruct patient history" server function.
ANTHROPIC_API_KEY=

# Optional: secret for authenticating scheduled/cron requests to server routes.
CRON_SECRET=
CRON_SECRET_PREVIOUS=
